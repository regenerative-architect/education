{
  "name": "ai-co-evolution-library-tools",
  "private": true,
  "version": "2.5.0",
  "description": "Maintainer tools for the AI Co-Evolution in Education app: build the library, vendor libraries, build the single file and the library downloads, stamp the service worker, check the site, and test everything.",
  "type": "module",
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "library": "node build-library.mjs",
    "vendor": "node vendor.mjs",
    "standalone": "node build-standalone.mjs",
    "downloads": "node build-downloads.mjs",
    "zim": "python3 build-zim.py",
    "cover": "node make-epub-cover.mjs",
    "stamp": "node stamp-sw.mjs",
    "check": "node check-site.mjs",
    "test": "node --test --test-concurrency=1 \"tests/*.test.mjs\"",
    "test:accessibility": "node --test tests/accessibility.test.mjs",
    "test:html": "node --test tests/html.test.mjs",
    "test:downloads": "node --test tests/downloads.test.mjs",
    "test:embedded": "node --test tests/embedded.test.mjs",
    "test:announcements": "node --test tests/announcements.test.mjs",
    "test:kiwix": "node --test tests/kiwix.test.mjs",
    "test:ladder": "node --test tests/ladder.test.mjs",
    "sbom": "node build-sbom.mjs"
  },
  "dependencies": {
    "@joplin/turndown-plugin-gfm": "1.0.68",
    "dompurify": "3.4.17",
    "esbuild": "0.28.2",
    "fflate": "0.8.3",
    "fzstd": "0.1.1",
    "gpt-tokenizer": "4.1.0",
    "jsdom": "30.1.3",
    "marked": "18.1.1",
    "minisearch": "7.2.0",
    "qrcode-generator": "2.0.4",
    "retext-english": "5.0.0",
    "retext-equality": "7.1.0",
    "retext-passive": "5.0.0",
    "retext-readability": "8.0.0",
    "retext-simplify": "8.0.0",
    "retext-stringify": "4.0.0",
    "syllable": "5.0.1",
    "ts-fsrs": "5.4.2",
    "turndown": "7.2.4",
    "unified": "11.0.5"
  },
  "devDependencies": {
    "@cyclonedx/cyclonedx-library": "10.3.0",
    "@guidepup/virtual-screen-reader": "0.33.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "ajv-formats-draft2019": "1.6.1",
    "axe-core": "4.14.0",
    "html-validate": "11.21.1",
    "playwright": "1.63.0"
  },
  "engines": {
    "node": ">=22.22"
  }
}
