{
  "name": "ai-co-evolution-library-tools",
  "private": true,
  "version": "2.2.0",
  "description": "Maintainer tools for the AI Co-Evolution in Education app: build the library, vendor libraries, build the single file and the library downloads, stamp the service worker, check the site, and test everything.",
  "type": "module",
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "library": "node build-library.mjs",
    "vendor": "node vendor.mjs",
    "standalone": "node build-standalone.mjs",
    "downloads": "node build-downloads.mjs",
    "cover": "node make-epub-cover.mjs",
    "stamp": "node stamp-sw.mjs",
    "check": "node check-site.mjs",
    "test": "node --test --test-concurrency=1 \"tests/*.test.mjs\"",
    "test:accessibility": "node --test tests/accessibility.test.mjs",
    "test:html": "node --test tests/html.test.mjs",
    "test:downloads": "node --test tests/downloads.test.mjs"
  },
  "dependencies": {
    "@joplin/turndown-plugin-gfm": "1.0.68",
    "dompurify": "3.4.17",
    "esbuild": "0.28.2",
    "fflate": "0.8.3",
    "gpt-tokenizer": "4.1.0",
    "jsdom": "30.1.3",
    "marked": "18.1.1",
    "minisearch": "7.2.0",
    "qrcode-generator": "2.0.4",
    "turndown": "7.2.4"
  },
  "devDependencies": {
    "axe-core": "4.14.0",
    "html-validate": "11.17.0",
    "playwright": "1.65.0"
  },
  "engines": {
    "node": ">=22.22"
  }
}
