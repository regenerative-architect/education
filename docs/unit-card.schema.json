{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AI Co-Evolution in Education: a unit file from the curriculum studio, version 1",
  "description": "What “Download the unit file” makes, and what “Open a unit file” accepts. The studio is stricter than this schema in one way: unknown goal and routine ids are dropped when a unit is opened. See docs/UNIT-FORMAT.md.",
  "type": "object",
  "required": ["format", "v", "unit"],
  "properties": {
    "format": { "const": "ai-co-evolution-unit" },
    "v": { "const": 1 },
    "exported": { "type": "string", "format": "date-time" },
    "app": { "type": "string", "maxLength": 100 },
    "unit": { "$ref": "#/definitions/unit" }
  },
  "definitions": {
    "lines": { "type": "array", "items": { "type": "string", "minLength": 1, "maxLength": 300 } },
    "goalIds": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[rla]-[a-z]{2,20}$" } },
    "ownGoals": { "type": "array", "maxItems": 6, "items": { "type": "string", "minLength": 1, "maxLength": 200 } },
    "license": { "enum": ["CC-BY-SA-4.0", "CC-BY-4.0", "CC0-1.0", "none"] },
    "unitId": { "type": "string", "pattern": "^u-[a-z0-9]{6,20}$" },
    "session": {
      "type": "object",
      "required": ["title", "stage", "routine", "ai", "aiWhy", "notes"],
      "additionalProperties": false,
      "properties": {
        "title": { "type": "string", "maxLength": 160 },
        "stage": { "enum": ["model", "guided", "together", "alone"], "description": "Who leads the thinking: I show, we practise, you try together, you lead" },
        "routine": { "type": "string", "pattern": "^([a-z]+(-[a-z]+)*)?$", "description": "A routine id from the studio's routine library, or empty" },
        "ai": { "type": "integer", "minimum": 1, "maximum": 5, "description": "AI use level: 1 no AI, 2 AI planning, 3 AI collaboration, 4 full AI, 5 AI exploration" },
        "aiWhy": { "type": "string", "maxLength": 300 },
        "notes": { "type": "string", "maxLength": 2000 }
      }
    },
    "unit": {
      "type": "object",
      "required": ["v", "id", "title", "subject", "question", "band", "minutes", "why", "goals", "own", "task", "choices", "criteria", "plan",
        "supports", "family", "core", "adapt", "reflect", "history", "by", "license", "basedOn", "created", "updated"],
      "additionalProperties": false,
      "properties": {
        "v": { "const": 1 },
        "id": { "$ref": "#/definitions/unitId" },
        "title": { "type": "string", "maxLength": 120 },
        "subject": { "type": "string", "maxLength": 80 },
        "question": { "type": "string", "maxLength": 200 },
        "band": { "enum": ["5-8", "9-12", "13-15", "16-18", "adult"], "description": "Learners' ages; under 13, AI use is teacher-led" },
        "minutes": { "enum": [30, 45, 50, 60, 90] },
        "why": { "type": "string", "maxLength": 1200 },
        "goals": {
          "type": "object", "additionalProperties": false, "required": ["reasoning", "literacy", "autonomy"],
          "properties": { "reasoning": { "$ref": "#/definitions/goalIds" }, "literacy": { "$ref": "#/definitions/goalIds" }, "autonomy": { "$ref": "#/definitions/goalIds" } }
        },
        "own": {
          "type": "object", "additionalProperties": false, "required": ["reasoning", "literacy", "autonomy"],
          "properties": { "reasoning": { "$ref": "#/definitions/ownGoals" }, "literacy": { "$ref": "#/definitions/ownGoals" }, "autonomy": { "$ref": "#/definitions/ownGoals" } }
        },
        "task": { "type": "string", "maxLength": 2000 },
        "choices": { "allOf": [{ "$ref": "#/definitions/lines" }, { "maxItems": 12 }] },
        "criteria": { "allOf": [{ "$ref": "#/definitions/lines" }, { "maxItems": 12 }] },
        "plan": { "type": "array", "maxItems": 20, "items": { "$ref": "#/definitions/session" } },
        "supports": { "allOf": [{ "$ref": "#/definitions/lines" }, { "maxItems": 12 }] },
        "family": { "type": "string", "maxLength": 3000 },
        "core": { "allOf": [{ "$ref": "#/definitions/lines" }, { "maxItems": 10 }] },
        "adapt": { "allOf": [{ "$ref": "#/definitions/lines" }, { "maxItems": 10 }] },
        "reflect": {
          "type": "object", "additionalProperties": false, "required": ["kept", "change", "voice"],
          "properties": { "kept": { "type": "string", "maxLength": 1500 }, "change": { "type": "string", "maxLength": 1500 }, "voice": { "type": "string", "maxLength": 1500 } }
        },
        "history": {
          "type": "array", "maxItems": 50,
          "items": { "type": "object", "additionalProperties": false, "required": ["date", "note"],
            "properties": { "date": { "type": "string", "format": "date" }, "note": { "type": "string", "minLength": 1, "maxLength": 200 } } }
        },
        "by": { "type": "string", "maxLength": 120, "description": "Optional credit: a name or a team" },
        "license": { "$ref": "#/definitions/license" },
        "basedOn": {
          "type": "array", "maxItems": 20, "description": "The units this one adapts, oldest first, so credit travels with it",
          "items": { "type": "object", "additionalProperties": false, "required": ["title", "by", "license"],
            "properties": { "id": { "$ref": "#/definitions/unitId" }, "title": { "type": "string", "minLength": 1, "maxLength": 160 },
              "by": { "type": "string", "maxLength": 120 }, "license": { "$ref": "#/definitions/license" } } }
        },
        "created": { "type": "string", "format": "date-time" },
        "updated": { "type": "string", "format": "date-time" }
      }
    }
  }
}
